# Copy to .env next to docker-compose.yml.

POSTGRES_USER=setlist
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=setlist

# The LXC's Tailscale address. Leave as 127.0.0.1 until Tailscale is up --
# never set this to 0.0.0.0, and never port-forward to it (spec 3).
BIND_ADDR=127.0.0.1

# Optional. Without it, alerts are logged instead of delivered (spec 8).
SETLIST_HOME_ASSISTANT_WEBHOOK_URL=

# Tuning. All of these are safe to change and re-run the nightly job (spec 11).
SETLIST_ASSOCIATION_BEFORE_MINUTES=30
SETLIST_ASSOCIATION_AFTER_MINUTES=45
SETLIST_PLAY_GAP_MINUTES=15
SETLIST_QUIET_ALERT_MINUTES=20
